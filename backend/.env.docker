# Environment variable template for Docker Compose configurations
# Copy this file to .env (or pass variables via system env) when running `docker compose up`

# PostgreSQL Settings
POSTGRES_DB=gatewaytofuture
POSTGRES_PASSWORD=db_secure_pass_2026

# JWT Authentication Settings
JWT_SECRET=production_secret_key_needs_rotation_999

# Razorpay live credentials (override these in production)
RAZORPAY_KEY_ID=rzp_live_production_key
RAZORPAY_KEY_SECRET=rzp_live_production_secret
RAZORPAY_WEBHOOK_SECRET=rzp_live_webhook_secret

# Initial Super Admin Seed Settings
ADMIN_INIT_EMAIL=admin@gatewaytofuture.com
ADMIN_INIT_PASSWORD=ChangeAdminPass2026!
