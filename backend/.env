# Server Settings
PORT=5000
NODE_ENV=development

# Security Settings
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=1h

# Database Settings (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gatewaytofuture?schema=public
# Set DB_MOCK=true to bypass real database connection and use in-memory mock repository for tests or quick runs
DB_MOCK=true

# Cache Settings (Redis)
REDIS_URL=redis://localhost:6379
# Set REDIS_MOCK=true to bypass real Redis connection and use in-memory cache
REDIS_MOCK=true

# Razorpay Payment Gateway Settings
RAZORPAY_KEY_ID=rzp_test_mock_id_123
RAZORPAY_KEY_SECRET=mock_secret_key_456
RAZORPAY_WEBHOOK_SECRET=mock_webhook_secret_789
# Set PAY_MOCK=true to run payment operations in simulation/mock mode
PAY_MOCK=true

# Initial Super Admin Seed Settings
ADMIN_INIT_EMAIL=admin@gatewaytofuture.com
ADMIN_INIT_PASSWORD=AdminPass123!
