# =============================================================================
# THE GATEWAY TO FUTURE (GTF) — GCP N8N ENGINE ENVIRONMENT CONFIGURATION
# Production Backend on Compute Engine (gateway-to-future)
# Headquarters: Ketschendorfer Weg 33, 12683 Berlin
# =============================================================================

# ── 1. Domain & SSL Setup ────────────────────────────────────────────────────
N8N_DOMAIN=n8n.gatewaytofuture.com

# ── 2. n8n Security ──────────────────────────────────────────────────────────
# Generate a secure 32-byte hex string: openssl rand -hex 16
N8N_ENCRYPTION_KEY=gtf-berlin-n8n-encryption-key-2026
N8N_USER_MANAGEMENT_DISABLED=false

# ── 3. Meta WhatsApp Cloud API (Outreach & Onboarding) ───────────────────────
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_VERIFY_TOKEN=gtf-berlin-whatsapp-verify-2026

# ── 4. Google Workspace CRM Integration ──────────────────────────────────────
GTF_MASTER_GOOGLE_SHEET_ID=

# ── 5. GTF Exam Portal & Webhook Security ────────────────────────────────────
UNLOCK_WEBHOOK_SECRET=gtf-local-dev-secret
