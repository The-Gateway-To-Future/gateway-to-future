    "clsx": "^2.1.1",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "framer-motion": "^14.12.0",
    "googleapis": "^144.0.0",
    "lucide-react": "^0.460.0",
    "next": "^15.5.7",
    "pdfjs-dist": "4.10.38",
