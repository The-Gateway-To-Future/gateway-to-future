    "prebuild": "node scripts/generate-obsidian-theme.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "safe-deploy": "python scripts/gtf_qa_gatekeeper.py",
