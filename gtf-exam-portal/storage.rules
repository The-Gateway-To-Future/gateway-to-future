rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function: verifies GTF Admin privileges via custom claims or verified bootstrap founder emails
    function isAdmin() {
      return request.auth != null && (
        (('admin' in request.auth.token) && request.auth.token.admin == true) ||
        (('role' in request.auth.token) && request.auth.token.role == 'admin') ||
        (
          ('email' in request.auth.token) &&
          ('email_verified' in request.auth.token) &&
          request.auth.token.email_verified == true && (
            request.auth.token.email == 'ashusharma@gatewaytofuture.com' ||
            request.auth.token.email == 'skour8786@gmail.com'
          )
        )
      );
    }

    // Authenticated educational audio & public preview media (verified students only)
    match /audio/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /media/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /learning/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /catalog/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Paid digital workbooks & course materials: Admin/Server-only (streamed through signed media tokens)
    match /workbooks/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /materials/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Default catch-all: deny unauthenticated access; admin-only writes
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
